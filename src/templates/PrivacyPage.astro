---
import { fmt, formatDate, t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { contactLinks } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);
const p = c.privacy;
const email = contactLinks(locale).email;
---

<Base locale={locale} page="privacy">
  <section class="section">
    <div class="container prose">
      <h1>{p.title}</h1>
      <p class="lead">{p.intro}</p>
      {
        p.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <p>{s.body}</p>
          </>
        ))
      }
      <h2>{p.rights.heading}</h2>
      <p>{p.rights.body}</p>
      {
        email && (
          <p>
            {p.rights.emailCta} <a href={email.href}>{email.address}</a>
          </p>
        )
      }
      <p class="muted updated">{fmt(p.updatedLabel, { date: formatDate(locale, p.updatedAt) })}</p>
    </div>
  </section>
</Base>

<style>
  .prose {
    max-width: 42rem;
  }
  .prose h2 {
    font-size: 1.5rem;
    margin-top: var(--space-6);
  }
  .updated {
    margin-top: var(--space-7);
    font-size: var(--text-sm);
  }
</style>
