---
import BookButton from '../components/BookButton.astro';
import CalInline from '../components/CalInline.astro';
import Leaf from '../components/art/Leaf.astro';
import Star from '../components/art/Star.astro';
import Photo from '../components/Photo.astro';
import { t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { isPreviewMode } from '../lib/mode';
import { shown, shows } from '../lib/placeholder';
import { settings } from '../lib/settings';
import { contactLinks } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);
const h = c.home;
const preview = isPreviewMode();
const links = contactLinks(locale);
const steps = shown(h.howItWorks.steps, preview);
const details = shown(h.session.details, preview);
const testimonials = shown(h.testimonials.items, preview);
const faq = shown(h.faq.items, preview);
---

<Base locale={locale} page="home">
  <section class="hero">
    <Leaf class="hero-leaf" />
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><Star size={14} />{h.hero.eyebrow}</p>
        <h1>{h.hero.title}</h1>
        <p class="lead">{h.hero.subtitle}</p>
        <div class="actions">
          <BookButton locale={locale} onHome />
          {
            links.whatsapp && (
              <a class="btn btn--secondary" href={links.whatsapp} target="_blank" rel="noopener">
                {c.ui.whatsapp}
                <span class="visually-hidden">{c.a11y.newTab}</span>
              </a>
            )
          }
        </div>
      </div>
      <Photo file={settings.photos.hero} alt={h.hero.photoAlt} eager class="hero-photo" />
    </div>
  </section>
  <div class="wave-band" aria-hidden="true"></div>

  {
    steps.length > 0 && (
      <section class="section" aria-labelledby="como-funciona">
        <div class="container">
          <h2 id="como-funciona" class="section-title">
            {h.howItWorks.title}
          </h2>
          <ol class="steps">
            {steps.map((step) => (
              <li class="step">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section section--surface" aria-labelledby="a-leitura">
    <div class="container narrow">
      <h2 id="a-leitura" class="section-title">{h.session.title}</h2>
      <div class="card session-card">
        <h3>{h.session.name}</h3>
        <ul class="session-details">
          {
            details.map((d) => (
              <li>
                <Star size={12} />
                {d}
              </li>
            ))
          }
        </ul>
        <dl class="session-facts">
          {
            shows(h.session.turnaround, preview) && (
              <div>
                <dt>{h.session.turnaroundLabel}</dt>
                <dd>{h.session.turnaround}</dd>
              </div>
            )
          }
          {
            shows(h.session.price, preview) && (
              <div>
                <dt>{h.session.priceLabel}</dt>
                <dd class="price">{h.session.price}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section booking" id={c.routes.bookingAnchor} aria-labelledby="agendar-titulo">
    <div class="container narrow">
      <h2 id="agendar-titulo" class="section-title">{h.booking.title}</h2>
      <p class="booking-intro">{h.booking.intro}</p>
      <CalInline locale={locale} />
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section section--surface" aria-labelledby="depoimentos">
        <div class="container">
          <h2 id="depoimentos" class="section-title">
            {h.testimonials.title}
          </h2>
          <div class="testimonials">
            {testimonials.map((item) => (
              <figure class="card testimonial">
                <blockquote>
                  <p>{item.quote}</p>
                </blockquote>
                <figcaption>{item.author}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    faq.length > 0 && (
      <section class="section" aria-labelledby="perguntas">
        <div class="container narrow">
          <h2 id="perguntas" class="section-title">
            {h.faq.title}
          </h2>
          <div class="faq">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section closing">
    <div class="container narrow">
      <h2>{h.closing.title}</h2>
      <p class="lead">{h.closing.text}</p>
      <BookButton locale={locale} onHome />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(165deg, var(--color-sunset) 0%, var(--color-lavender) 42%, var(--color-bg) 100%);
    padding-block: var(--space-7) var(--space-8);
  }
  .hero :global(.hero-leaf) {
    position: absolute;
    width: 16rem;
    right: -4rem;
    top: -2rem;
    transform: rotate(-25deg);
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero :global(.hero-photo) {
    width: min(100%, 24rem);
    justify-self: center;
  }
  @media (min-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .hero :global(.hero-photo) {
      width: 100%;
    }
  }

  .narrow {
    max-width: 46rem;
  }

  .steps {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }
  .step {
    counter-increment: step;
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .step::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-3);
    border: 2px solid var(--color-gold);
    border-radius: 50%;
    font-family: var(--font-heading);
    font-size: 1.25rem;
  }
  .step h3 {
    font-size: 1.2rem;
    margin-bottom: var(--space-2);
  }
  .step p {
    margin: 0;
  }

  .session-card {
    border-top: 4px solid var(--color-sage);
  }
  .session-details {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .session-details li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .session-facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .session-facts div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid rgb(122 90 67 / 0.2);
  }
  .session-facts dt {
    color: var(--color-earth);
  }
  .session-facts dd {
    margin: 0;
    font-weight: 600;
  }
  .price {
    font-family: var(--font-heading);
    font-size: 1.5rem;
  }

  .booking-intro {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .testimonials {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .testimonials {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
  .testimonial {
    margin: 0;
    border-left: 4px solid var(--color-lavender);
  }
  .testimonial blockquote {
    margin: 0 0 var(--space-4);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-style: italic;
  }
  .testimonial figcaption {
    color: var(--color-earth);
    font-weight: 600;
  }

  .faq {
    display: grid;
    gap: var(--space-3);
  }
  .faq details {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 0 var(--space-5);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-forest);
  }
  .faq details[open] summary::after {
    content: '–';
  }
  .faq details p {
    padding-bottom: var(--space-4);
    margin: 0;
  }

  .closing {
    text-align: center;
    background: linear-gradient(180deg, var(--color-bg), var(--color-sage) 260%);
  }
</style>
