---
// Monstera leaf line drawing, decorative.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['leaf', className]} viewBox="0 0 200 220" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M100 210C98 160 96 120 100 20" />
    <path d="M100 20C55 25 18 62 14 112c-3 45 30 82 86 98 56-16 89-53 86-98C182 62 145 25 100 20Z" />
    <path d="M99 60 52 44M99 90 30 82M99 122 28 128M99 152 46 170" />
    <path d="M101 60 148 44M101 90 170 82M101 122 172 128M101 152 154 170" />
    <path d="M60 70c-8 10-10 22-8 30M150 104c8 10 8 22 4 30" />
  </g>
</svg>

<style>
  .leaf {
    color: var(--color-forest);
    opacity: 0.18;
    pointer-events: none;
  }
</style>
