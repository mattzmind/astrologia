---
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 16 } = Astro.props;
---

<svg class:list={['star', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d="M12 1.5c.6 5.4 3.1 9.9 10.5 10.5-7.4.6-9.9 5.1-10.5 10.5C11.4 17.1 8.9 12.6 1.5 12c7.4-.6 9.9-5.1 10.5-10.5Z" fill="currentColor" />
</svg>

<style>
  .star {
    color: var(--color-gold);
    flex: none;
  }
</style>
