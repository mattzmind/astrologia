---
// A photo of Gabby from src/assets/photos/, by file name (see settings.json → photos).
// Until the file exists, a zodiac wheel drawing stands in.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ZodiacWheel from './art/ZodiacWheel.astro';

interface Props {
  file: string | undefined;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { file, alt, eager = false, sizes = '(min-width: 56rem) 28rem, 90vw', class: className } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const image = file ? Object.entries(photos).find(([path]) => path.endsWith(`/${file}`))?.[1].default : undefined;
---

<div class:list={['photo', { 'photo--art': !image }, className]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[360, 540, 720, 1080]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <ZodiacWheel />
    )
  }
</div>

<style>
  .photo {
    border-radius: 2rem 2rem 2rem 0.5rem;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo--art {
    display: grid;
    place-items: center;
    padding: 12%;
    background: radial-gradient(circle at 50% 40%, var(--color-surface), var(--color-bg));
  }
</style>
